@using EntityLayer.Concrate
@model List<Service>


    @{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    }
    

    <h1>Hizmetler Listesi</h1>


    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Başlık</th>
            </tr>
            @foreach (var item in Model)
            {
            <tr>
                <td>@item.ServiceID</td>
                <td>@item.Title</td>
            </tr>
            }

        </thead>
    </table>
    
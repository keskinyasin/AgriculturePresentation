@using EntityLayer.Concrate;
@model List<Announcement>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Duyuru Listesi</h4>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Başlık
                            </th>
                            <th>
                               Tarih
                            </th>
                            <th>
                                Sil
                            </th>
                            <th>
                                Düzenle
                            </th>
                            <th>
                                Durum
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.AnnouncementID
                                </td>
                                <td>
                                    @item.Title
                                </td>
                                <td>
                                    @item.Date
                                </td>
                                <td>
                                    <a asp-action="DeleteAnnounscement" asp-route-id="@item.AnnouncementID" class="btn btn-outline-danger btn-sm">Sil</a>
                                </td>
                                <td>
                                    <a asp-action="EditAnnounscement" asp-route-id="@item.AnnouncementID" class="btn btn-outline-success btn-sm">Düzenle</a>
                                </td>
                                
                                <td>
                                    <a asp-action="ChangeStatus" asp-route-id="@item.AnnouncementID" class="btn btn-sm @(item.Status ? "btn-outline-secondary" : "btn-outline-warning")">@((item.Status) ? "Pasif Yap" : "Aktif Yap")</a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <br />
                <a asp-action="AddAnnouncement" class="btn btn-outline-info me-2">Yeni Duyuru Girişi</a>
            </div>
        </div>
    </div>
</div>




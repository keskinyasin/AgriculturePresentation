@using EntityLayer.Concrate;
@model List<Service>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Hizmet Listesi</h4>
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                #
                            </th>
                            <th>
                                Başlık
                            </th>
                            <th>
                                Sil
                            </th>
                            <th>
                                Düzenle
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.ServiceID
                                </td>
                                <td>
                                    @item.Title
                                </td>
                                <td>
                                    <a asp-action="DeleteService" asp-route-id="@item.ServiceID" class="btn btn-outline-danger btn-sm">Sil</a>
                                </td>
                                <td>
                                    <a asp-action="EditService" asp-route-id="@item.ServiceID" class="btn btn-outline-success btn-sm">Düzenle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <a asp-action="AddService" class="btn btn-outline-info me-2">Yeni Hizmet Ekle</a>
            </div>
        </div>
    </div>
</div>

